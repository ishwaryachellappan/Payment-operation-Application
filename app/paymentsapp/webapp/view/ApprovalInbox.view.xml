<mvc:View
    controllerName="paymentsapp.controller.ApprovalInbox"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        showHeader="true"
        class="approvalPage">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <customHeader>

            <Toolbar class="approvalHeader">

                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    tooltip="Back"
                    press=".onBack"/>

                <HBox
                    alignItems="Center"
                    class="approvalBrand">

                    <core:Icon
                        src="sap-icon://task"
                        size="1.25rem"
                        class="approvalBrandIcon"/>

                    <Title
                        text="Approval Inbox"
                        level="H2"
                        class="approvalHeaderTitle"/>

                </HBox>

                <ToolbarSpacer/>

                <Button
                    text="Refresh"
                    icon="sap-icon://refresh"
                    type="Transparent"
                    press=".onRefresh"
                    class="approvalRefresh"/>

            </Toolbar>

        </customHeader>


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <content>

            <VBox
                class="approvalContent">


                <!-- ================================================= -->
                <!-- PAGE INTRO -->
                <!-- ================================================= -->

                <VBox
                    class="approvalIntro">

                    <Title
                        text="Payment Approvals"
                        level="H1"
                        class="approvalTitle"/>

                    <Text
                        text="Review and process payments awaiting approval."
                        class="approvalSubtitle"/>

                </VBox>


                <!-- ================================================= -->
                <!-- SUMMARY CARD -->
                <!-- ================================================= -->

                <HBox
                    class="approvalSummary"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <HBox
                        alignItems="Center">

                        <HBox
                            class="approvalSummaryIcon"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://pending"
                                size="1.4rem"/>

                        </HBox>

                        <VBox
                            class="approvalSummaryText">

                            <Text
                                text="Pending Payments"
                                class="approvalSummaryLabel"/>

                            <Text
                                id="approvalInboxTitle"
                                text="Pending Payments (0)"
                                class="approvalSummaryCount"/>

                        </VBox>

                    </HBox>


                    <Text
                        text="Requires your attention"
                        class="approvalAttention"/>

                </HBox>


                <!-- ================================================= -->
                <!-- TABLE CARD -->
                <!-- ================================================= -->

                <VBox
                    class="approvalTableCard">


                    <!-- TABLE HEADER -->

                    <HBox
    class="approvalTableHeader"
    justifyContent="SpaceBetween"
    alignItems="Center">

    <VBox>

        <Title
            text="Pending Approval Queue"
            level="H2"
            class="approvalTableTitle"/>

        <Text
            text="Payments currently awaiting review"
            class="approvalTableSubtitle"/>

    </VBox>

    <HBox
        alignItems="Center"
        class="bulkApprovalActions">

        <Text
            id="selectedCountText"
            text="0 selected"
            class="selectedCountText"/>

        <Button
            id="bulkApproveButton"
            text="Approve All"
            icon="sap-icon://accept"
            type="Accept"
            enabled="false"
            press=".onBulkApprove"
            class="bulkApproveButton"/>

    </HBox>

</HBox>


                    <!-- ================================================= -->
                    <!-- TABLE -->
                    <!-- ================================================= -->

                    <Table
    id="approvalTable"
    items="{approval>/payments}"
    mode="MultiSelect"
    includeItemInSelection="true"
    growing="true"
    growingThreshold="20"
    growingScrollToLoad="false"
    noDataText="No payments are currently awaiting approval."
    selectionChange=".onPaymentSelectionChange"
    class="approvalTable">


                        <!-- ================================================= -->
                        <!-- COLUMNS -->
                        <!-- ================================================= -->

                        <columns>


                            <!-- PAYMENT REFERENCE -->

                            <Column
                                width="17%">

                                <Text
                                    text="Payment Reference"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- COMPANY -->

                            <Column
                                width="10%">

                                <Text
                                    text="Company"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- DEBTOR -->

                            <Column
                                width="16%">

                                <Text
                                    text="Debtor Account"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- CREDITOR -->

                            <Column
                                width="16%">

                                <Text
                                    text="Creditor Account"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- AMOUNT -->

                            <Column
                                width="12%"
                                hAlign="End">

                                <Text
                                    text="Amount"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- CURRENCY -->

                            <Column
                                width="8%">

                                <Text
                                    text="Currency"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- PAYMENT DATE -->

                            <Column
                                width="11%">

                                <Text
                                    text="Payment Date"
                                    class="approvalColumnHeader"/>

                            </Column>


                            <!-- ACTIONS -->

                            <Column
                                width="17%"
                                hAlign="Center">

                                <Text
                                    text="Actions"
                                    class="approvalColumnHeader"/>

                            </Column>

                        </columns>


                        <!-- ================================================= -->
                        <!-- ROWS -->
                        <!-- ================================================= -->

                        <items>

                            <ColumnListItem
                                class="approvalRow">

                                <cells>


                                    <!-- PAYMENT REFERENCE -->

                                    <VBox>

                                        <Text
                                            text="{approval>paymentReference}"
                                            class="approvalReference"/>

                                        <ObjectStatus
                                            text="Pending Approval"
                                            state="Warning"
                                            icon="sap-icon://pending"
                                            class="approvalStatus"/>

                                    </VBox>


                                    <!-- COMPANY -->

                                    <Text
                                        text="{approval>companyCode}"
                                        class="approvalCell"/>


                                    <!-- DEBTOR -->

                                    <Text
                                        text="{approval>debtorAccount}"
                                        class="approvalAccount"/>


                                    <!-- CREDITOR -->

                                    <Text
                                        text="{approval>creditorAccount}"
                                        class="approvalAccount"/>


                                    <!-- AMOUNT -->

                                    <ObjectNumber
                                        number="{approval>amount}"
                                        emphasized="true"
                                        class="approvalAmount"/>


                                    <!-- CURRENCY -->

                                    <Text
                                        text="{approval>currency}"
                                        class="approvalCurrency"/>


                                    <!-- PAYMENT DATE -->

                                    <Text
                                        text="{approval>paymentDate}"
                                        class="approvalCell"/>


                                    <!-- ACTIONS -->

                                    <HBox
                                        justifyContent="Center"
                                        alignItems="Center"
                                        class="approvalActions">


                                        <Button
                                            text="Approve"
                                            icon="sap-icon://accept"
                                            type="Accept"
                                            press=".onApprove"
                                            class="approveButton"/>


                                        <Button
                                            text="Reject"
                                            icon="sap-icon://decline"
                                            type="Reject"
                                            press=".onReject"
                                            class="rejectButton"/>

                                    </HBox>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <HBox
                    justifyContent="End"
                    class="approvalFooter">

                    <Text
                        text="Payment Operations"
                        class="approvalFooterText"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>