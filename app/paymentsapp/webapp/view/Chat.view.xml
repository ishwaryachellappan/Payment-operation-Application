<mvc:View
    controllerName="paymentsapp.controller.Chat"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        showHeader="false"
        class="chatPage">

        <content>

            <HBox
                width="100%"
                height="100%"
                class="chatContainer">

                <!-- ================================================= -->
                <!-- LEFT USER PANEL -->
                <!-- ================================================= -->

                                <VBox
    width="300px"
    height="100%"
    class="chatSidebar">

    <!-- HEADER -->

    <VBox class="chatSidebarHeader">

        <Title
            text="Chat"
            level="H2"
            class="chatTitle"/>

        <Text
            text="Messages &amp; conversations"
            class="chatSubtitle"/>

    </VBox>


    <!-- SEARCH -->

    <SearchField
        id="userSearch1"
        width="calc(100% - 24px)"
        placeholder="Search users..."
        liveChange=".onUserSearch"
        class="chatSearch"/>


    <!-- ================================================= -->
    <!-- DIRECT MESSAGES -->
    <!-- ================================================= -->

    <Title
        text="DIRECT MESSAGES"
        level="H5"
        class="chatSectionTitle"/>


    <List
        id="userList"
        items="{users>/items}"
        mode="None"
        noDataText="No users found"
        growing="true"
        growingThreshold="30"
        showSeparators="None"
        class="chatUserList">

        <CustomListItem
            type="Active"
            press=".onUserSelect"
            class="chatUserListItem">

            <HBox
                width="100%"
                alignItems="Center"
                class="chatUserRow">

                <!-- Avatar -->

                <HBox
                    justifyContent="Center"
                    alignItems="Center"
                    class="chatAvatar">

                    <core:Icon
                        src="sap-icon://person-placeholder"
                        size="1.1rem"/>

                </HBox>


                <!-- User -->

                <VBox
                    width="100%"
                    class="chatUserInfo">

                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <Text
                            text="{users>fullName}"
                            wrapping="false"
                            class="{= ${users>hasUnread}
                                ? 'chatUserFullName chatUserUnread'
                                : 'chatUserFullName'}"/>

                        <ObjectStatus
                            text="{users>unreadCount}"
                            visible="{= ${users>unreadCount} > 0 }"
                            state="Information"
                            class="chatUnreadBadge"/>

                    </HBox>


                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween">

                        <Text
                            text="{= '@' + ${users>userName} }"
                            wrapping="false"
                            class="chatUserName"/>

                        <Text
                            text="{users>lastMessageTime}"
                            visible="{= !!${users>lastMessageTime} }"
                            class="chatLastTime"/>

                    </HBox>


                    <Text
                        text="{users>lastMessage}"
                        wrapping="false"
                        maxLines="1"
                        class="chatLastMessage"/>

                </VBox>

            </HBox>

        </CustomListItem>

    </List>


    <!-- ================================================= -->
    <!-- GROUPS HEADER -->
    <!-- ================================================= -->

    <HBox
        width="100%"
        justifyContent="SpaceBetween"
        alignItems="Center"
        class="chatGroupHeader">

        <Title
            text="GROUPS"
            level="H5"
            class="chatSectionTitle"/>

       <Button
        icon="sap-icon://add"
        type="Transparent"
        tooltip="Create Group"
        press=".onCreateGroup"
        class="chatAddGroupButton"/>

    </HBox>


    <!-- ================================================= -->
    <!-- GROUP LIST -->
    <!-- ================================================= -->

   <List
    id="groupList"
    items="{groups>/items}"
    mode="None"
    showSeparators="None"
    noDataText="No groups yet">

    <CustomListItem
        type="Active"
        press=".onGroupSelect">

        <HBox
            width="100%"
            alignItems="Center"
            class="chatUserRow">

            <HBox
                justifyContent="Center"
                alignItems="Center"
                class="chatAvatar">

                <core:Icon
                    src="sap-icon://group"
                    size="1.1rem"/>

            </HBox>

            <VBox
                width="100%"
                class="chatUserInfo">

                <Text
                    text="{groups>groupName}"
                    wrapping="false"
                    class="chatUserFullName"/>

                <Text
                    text="{groups>description}"
                    wrapping="false"
                    class="chatUserName"/>

            </VBox>

            <ObjectNumber
                number="{groups>unreadCount}"
                visible="{= ${groups>unreadCount} > 0 }"/>

            <Button
    icon="sap-icon://delete"
    type="Transparent"
    tooltip="Delete group"
    visible="{= ${groups>createdBy} === ${chat>/currentUser} }"
    press=".onDeleteGroupPress"
    class="chatDeleteGroupButton"/>

        </HBox>

    </CustomListItem>

</List>
</VBox>


                <!-- ================================================= -->
                <!-- RIGHT CONVERSATION PANEL -->
                <!-- ================================================= -->

                <VBox
                    width="100%"
                    height="100%"
                    class="chatMainPanel">


                    <!-- Conversation header -->

                    <VBox
    visible="{= !!${chat>/selectedUserName} || !!${chat>/selectedGroupId} }"
    class="chatConversationHeader">

    <HBox
        alignItems="Center">

        <!-- DIRECT CHAT AVATAR -->

        <HBox
            visible="{= ${chat>/chatType} === 'DIRECT' }"
            justifyContent="Center"
            alignItems="Center"
            class="chatHeaderAvatar">

            <core:Icon
                src="sap-icon://person-placeholder"
                size="1.2rem"/>

        </HBox>


        <!-- GROUP CHAT AVATAR -->

        <HBox
            visible="{= ${chat>/chatType} === 'GROUP' }"
            justifyContent="Center"
            alignItems="Center"
            class="chatHeaderAvatar chatGroupHeaderAvatar">

            <core:Icon
                src="sap-icon://group"
                size="1.2rem"/>

        </HBox>


        <VBox>

            <!-- Direct -->

            <Title
                text="{chat>/selectedFullName}"
                visible="{= ${chat>/chatType} === 'DIRECT' }"
                level="H3"
                class="chatConversationTitle"/>


            <!-- Group -->

            <Title
                text="{chat>/selectedGroupName}"
                visible="{= ${chat>/chatType} === 'GROUP' }"
                level="H3"
                class="chatConversationTitle"/>


            <Text
                text="{= ${chat>/chatType} === 'GROUP'
                    ? 'Group conversation'
                    : '@' + ${chat>/selectedUserName} }"
                class="chatConversationUsername"/>

        </VBox>

    </HBox>

</VBox>


                    <!-- Empty state -->

                    <VBox
                        width="100%"
                        height="100%"
                        justifyContent="Center"
                        alignItems="Center"
                        visible="{= !${chat>/selectedUserName} &amp;&amp; !${chat>/selectedGroupId} }"
                        class="chatEmptyState">

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="chatEmptyIconContainer">

                            <core:Icon
                                src="sap-icon://discussion-2"
                                size="2.5rem"/>

                        </HBox>

                        <Title
                            text="Your conversations"
                            level="H2"
                            class="chatEmptyTitle"/>

                        <Text
                            text="Select a user from the left to start chatting."
                            class="chatEmptyText"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- MESSAGES -->
                    <!-- ================================================= -->

                    <ScrollContainer
                        id="chatScroll"
                        width="100%"
                        height="100%"
                        vertical="true"
                        horizontal="false"
                        visible="{= !!${chat>/selectedUserName} || !!${chat>/selectedGroupId} }"
                        class="chatMessagesContainer">

                        <VBox
                            width="100%"
                            items="{chat>/messages}"
                            class="chatMessages">

                            <HBox
                                width="100%"
                                justifyContent="{= ${chat>isMine} ? 'End' : 'Start' }"
                                class="chatMessageRow">

                             <VBox
    class="{= ${chat>isMine}
        ? 'chatBubble chatBubbleMine'
        : 'chatBubble chatBubbleOther' }">

    <!-- ================================================= -->
    <!-- GROUP MESSAGE SENDER -->
    <!-- ================================================= -->

    <Text
        text="{= ${chat>senderUserName} === ${chat>/currentUser}
            ? 'You'
            : ${chat>senderUserName} }"
        visible="{= ${chat>/chatType} === 'GROUP' }"
        wrapping="false"
        class="chatMessageSender"/>


    <!-- ================================================= -->
    <!-- MESSAGE -->
    <!-- ================================================= -->

    <Text
        text="{chat>message}"
        wrapping="true"
        class="chatMessageText"/>


    <!-- ================================================= -->
    <!-- TIME + READ RECEIPT -->
    <!-- ================================================= -->

    <HBox
        justifyContent="End"
        alignItems="Center"
        class="chatMessageFooter">

        <Text
            text="{chat>displayTime}"
            class="chatMessageTime"/>

        <Text
            text="{= ${chat>isMine}
                ? (${chat>isRead} ? '✓✓' : '✓')
                : '' }"
            visible="{chat>isMine}"
            class="chatReadReceipt"/>

    </HBox>

</VBox>

                            </HBox>

                        </VBox>

                    </ScrollContainer>


                    <!-- ================================================= -->
                    <!-- MESSAGE COMPOSER -->
                    <!-- ================================================= -->

                    <HBox
                        width="100%"
                        visible="{= !!${chat>/selectedUserName} || !!${chat>/selectedGroupId} }"
                        alignItems="End"
                        class="chatComposer">

                        <TextArea
                            id="chatInput"
                            width="100%"
                            rows="1"
                            growing="true"
                            growingMaxLines="5"
                            placeholder="Write a message..."
                            liveChange=".onChatInputChange"
                            class="chatTextArea"/>

                        <Button
                            id="sendChatButton"
                            icon="sap-icon://paper-plane"
                            type="Emphasized"
                            tooltip="Send message"
                            enabled="false"
                            press=".onSendMessage"
                            class="chatSendButton"/>

                    </HBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>