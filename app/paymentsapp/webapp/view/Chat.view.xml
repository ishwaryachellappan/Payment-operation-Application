<mvc:View
    controllerName="paymentsapp.controller.Chat"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        showHeader="false"
        class="chatPage">

        <content>

            <HBox
                width="100%"
                height="100%"
                class="chatContainer">

                <!-- ================================================= -->
                <!-- LEFT USER PANEL -->
                <!-- ================================================= -->

                <VBox
                    width="300px"
                    height="100%"
                    class="chatSidebar">

                    <VBox class="chatSidebarHeader">

                        <Title
                            text="Chat"
                            level="H2"
                            class="chatTitle"/>

                        <Text
                            text="Start a conversation"
                            class="chatSubtitle"/>

                    </VBox>

                    <SearchField
                        id="userSearch1"
                        width="calc(100% - 24px)"
                        placeholder="Search users..."
                        liveChange=".onUserSearch"
                        class="chatSearch"/>

                   <List
    id="userList"
    items="{users>/items}"
    mode="None"
    noDataText="No users found"
    growing="true"
    growingThreshold="30"
    showSeparators="Inner"
    class="chatUserList">

    <CustomListItem
        type="Active"
        press=".onUserSelect"
        class="chatUserListItem">

        <HBox
            width="100%"
            alignItems="Center"
            class="chatUserRow">


            <!-- AVATAR -->

            <HBox
                justifyContent="Center"
                alignItems="Center"
                class="chatAvatar">

                <core:Icon
                    src="sap-icon://person-placeholder"
                    size="1.2rem"/>

            </HBox>


            <!-- USER INFORMATION -->

            <VBox
                width="100%"
                class="chatUserInfo">


                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Center">


                    <Text
                        text="{users>fullName}"
                        wrapping="false"
                        class="chatUserFullName"
                        renderWhitespace="false"/>


                    <!-- UNREAD COUNT -->

                    <ObjectStatus
                        text="{users>unreadCount}"
                        visible="{= ${users>unreadCount} > 0 }"
                        state="Information"
                        class="chatUnreadBadge"/>

                </HBox>


                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Center">


                    <Text
                        text="{= '@' + ${users>userName} }"
                        wrapping="false"
                        class="chatUserName"/>


                    <Text
                        text="{users>lastMessageTime}"
                        visible="{= !!${users>lastMessageTime} }"
                        class="chatLastTime"/>

                </HBox>


                <Text
                    text="{users>lastMessage}"
                    wrapping="false"
                    maxLines="1"
                    class="chatLastMessage"/>

            </VBox>

        </HBox>

    </CustomListItem>

</List>

                </VBox>


                <!-- ================================================= -->
                <!-- RIGHT CONVERSATION PANEL -->
                <!-- ================================================= -->

                <VBox
                    width="100%"
                    height="100%"
                    class="chatMainPanel">


                    <!-- Conversation header -->

                    <VBox
                        visible="{= !!${chat>/selectedUserName} }"
                        class="chatConversationHeader">

                        <HBox
                            alignItems="Center">

                            <HBox
                                justifyContent="Center"
                                alignItems="Center"
                                class="chatHeaderAvatar">

                                <core:Icon
                                    src="sap-icon://person-placeholder"
                                    size="1.2rem"/>

                            </HBox>

                            <VBox>

                                <Title
                                    text="{chat>/selectedFullName}"
                                    level="H3"
                                    class="chatConversationTitle"/>

                                <Text
                                    text="{= '@' + ${chat>/selectedUserName} }"
                                    class="chatConversationUsername"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- Empty state -->

                    <VBox
                        width="100%"
                        height="100%"
                        justifyContent="Center"
                        alignItems="Center"
                        visible="{= !${chat>/selectedUserName} }"
                        class="chatEmptyState">

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="chatEmptyIconContainer">

                            <core:Icon
                                src="sap-icon://discussion-2"
                                size="2.5rem"/>

                        </HBox>

                        <Title
                            text="Your conversations"
                            level="H2"
                            class="chatEmptyTitle"/>

                        <Text
                            text="Select a user from the left to start chatting."
                            class="chatEmptyText"/>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- MESSAGES -->
                    <!-- ================================================= -->

                    <ScrollContainer
                        id="chatScroll"
                        width="100%"
                        height="100%"
                        vertical="true"
                        horizontal="false"
                        visible="{= !!${chat>/selectedUserName} }"
                        class="chatMessagesContainer">

                        <VBox
                            width="100%"
                            items="{chat>/messages}"
                            class="chatMessages">

                            <HBox
                                width="100%"
                                justifyContent="{= ${chat>senderUserName} === ${chat>/currentUser} ? 'End' : 'Start' }"
                                class="chatMessageRow">

                             <VBox
    class="{= ${chat>isMine}
        ? 'chatBubble chatBubbleMine'
        : 'chatBubble chatBubbleOther' }">

    <Text
        text="{chat>message}"
        wrapping="true"
        class="chatMessageText"/>

    <HBox
        justifyContent="End"
        alignItems="Center"
        class="chatMessageFooter">

        <Text
            text="{chat>displayTime}"
            class="chatMessageTime"/>

        <Text
            text="{= ${chat>isMine}
                ? (${chat>isRead} ? '✓✓' : '✓')
                : '' }"
            visible="{chat>isMine}"
            class="chatReadReceipt"/>

    </HBox>

</VBox>

                            </HBox>

                        </VBox>

                    </ScrollContainer>


                    <!-- ================================================= -->
                    <!-- MESSAGE COMPOSER -->
                    <!-- ================================================= -->

                    <HBox
                        width="100%"
                        visible="{= !!${chat>/selectedUserName} }"
                        alignItems="End"
                        class="chatComposer">

                        <TextArea
                            id="chatInput"
                            width="100%"
                            rows="1"
                            growing="true"
                            growingMaxLines="5"
                            placeholder="Write a message..."
                            liveChange=".onChatInputChange"
                            class="chatTextArea"/>

                        <Button
                            id="sendChatButton"
                            icon="sap-icon://paper-plane"
                            type="Emphasized"
                            tooltip="Send message"
                            enabled="false"
                            press=".onSendMessage"
                            class="chatSendButton"/>

                    </HBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>