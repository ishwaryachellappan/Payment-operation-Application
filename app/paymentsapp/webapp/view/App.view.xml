<mvc:View
    controllerName="paymentsapp.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <!-- ToolPage is SAP's standard app-shell layout control:            -->
    <!-- header + collapsible side nav + main content, height handled    -->
    <!-- internally. It is the root of the app, so it never gets torn    -->
    <!-- down when the router swaps page content in "app" below.         -->
    <tnt:ToolPage id="toolPage">

        <tnt:header>

            <tnt:ToolHeader>

                <Button
                    icon="sap-icon://menu2"
                    type="Transparent"
                    tooltip="Show/hide menu"
                    press=".onToggleSideNav"/>

                <core:Icon
                    src="sap-icon://money-bills"
                    size="1.3rem"
                    class="topBarIcon"/>



                <Title
                    text="Payment Operations"
                    level="H2"
                    class="topBarTitle"/>

             <ToolbarSpacer/>

<!-- Notification -->
<!-- =====================================================
     NOTIFICATIONS
     ===================================================== -->

<HBox
    id="notificationArea"
    alignItems="Center"
    class="notificationArea">

    <!-- Pending approvals - ADMIN only -->
    <HBox
        id="approvalNotificationArea"
        alignItems="Center"
        visible="{appView>/isAdmin}"
        class="notificationItem">

        <Button
            id="approvalNotificationButton"
            icon="sap-icon://bell"
            type="Transparent"
            tooltip="Pending Approvals"
            press=".onApprovalNotificationsPress"
            class="notificationButton"/>

        <Text
            id="approvalNotificationCount"
            text="0"
            visible="false"
            class="notificationBadge"/>

    </HBox>


    <!-- Unread messages - ALL USERS -->
    <HBox
        id="messageNotificationArea"
        alignItems="Center"
        class="notificationItem">

        <Button
            id="messageNotificationButton"
            icon="sap-icon://discussion"
            type="Transparent"
            tooltip="Messages"
            press=".onMessageNotificationsPress"
            class="notificationButton"/>

        <Text
            id="messageNotificationCount"
            text="0"
            visible="false"
            class="notificationBadge messageBadge"/>

    </HBox>

      <!-- =====================================================
     MAILBOX
     ===================================================== -->

<HBox
    id="mailArea"
    alignItems="Center"
    class="notificationItem">

    <Button
        id="mailButton"
        icon="sap-icon://email"
        type="Transparent"
        tooltip="Mailbox"
        press=".onMailPress"
        class="notificationButton"/>

    <Text
        id="mailCount"
        text="0"
        visible="false"
        class="notificationBadge mailBadge"/>

</HBox>

</HBox>

            </tnt:ToolHeader>

        </tnt:header>

        <tnt:sideContent>

            <tnt:SideNavigation
                id="sideNav"
                expanded="{appView>/sideExpanded}"
                selectedKey="{appView>/currentRoute}">

                <tnt:item>

                    <tnt:NavigationList>

                        <tnt:NavigationListItem
                            text="Dashboard"
                            icon="sap-icon://home"
                            key="Dashboard"
                            visible="{appView>/isAdmin}"
                            select=".onDashboard"/>

                        <tnt:NavigationListItem
                            text="Payments"
                            icon="sap-icon://money-bills"
                            key="Payments"
                            select=".onViewPayments"/>

                        <tnt:NavigationListItem
                            text="Approvals"
                            icon="sap-icon://task"
                            key="ApprovalInbox"
                            visible="{appView>/isAdmin}"
                            select=".onApprovalInbox"/>

                        <tnt:NavigationListItem
                            text="Users"
                            icon="sap-icon://group"
                            key="UserManagement"
                            visible="{appView>/isAdmin}"
                            select=".onUserManagement"/>

                             <tnt:NavigationListItem
        text="User Logs"
        icon="sap-icon://activity-items"
        key="UserLogs"
        visible="{appView>/isAdmin}"
        select=".onUserLogs"/>

       <tnt:NavigationListItem
    text="Chat"
    icon="sap-icon://discussion"
    key="Chat"
    select=".onChat"/>

                    </tnt:NavigationList>

                </tnt:item>

                <tnt:fixedItem>

                    <tnt:NavigationList>

                        <tnt:NavigationListItem
                            text="Logout"
                            icon="sap-icon://log"
                            key="Logout"
                            select=".onLogout"/>

                    </tnt:NavigationList>

                </tnt:fixedItem>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <tnt:mainContents>

            <!-- Router target: manifest.json controlId/controlAggregation -->
            <!-- ("app" / "pages") are unchanged. Only this control's       -->
            <!-- content is swapped when navigating between routes.         -->
            <App
                id="app"
                height="100%"
                width="100%"/>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>