<mvc:View
    controllerName="paymentsapp.controller.Payments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page
        showHeader="true"
        class="paymentsPage">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <customHeader>

            <Toolbar class="paymentsHeader">

                <Button
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    tooltip="Back"
                    press=".onBack"/>

                <Title
                    text="Payments"
                    level="H2"
                    class="paymentsHeaderTitle"/>

                <ToolbarSpacer/>

                <Button
                    text="Logout"
                    icon="sap-icon://log"
                    type="Transparent"
                    press=".onLogout"
                    class="logoutButton"/>

            </Toolbar>

        </customHeader>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <content>

            <VBox
                class="paymentsContent">


                <!-- ========================================= -->
                <!-- PAGE TITLE -->
                <!-- ========================================= -->

                <VBox class="paymentsIntro">

                    <Title
                        text="Payment List"
                        level="H2"
                        class="paymentsPageTitle"/>

                    <Text
                        text="View, create and manage payment transactions."
                        class="paymentsPageSubtitle"/>

                </VBox>


<!-- ========================================= -->
<!-- SUMMARY CARDS -->
<!-- ========================================= -->

<HBox
    class="paymentsSummaryRow"
    width="100%"
    wrap="Wrap">

    <VBox class="paymentsSummaryCard paymentsSummaryTotal">

        <Text
            text="Total Payments"
            class="paymentsSummaryLabel"/>

        <Title
            id="summaryTotal"
            text="0"
            level="H2"
            class="paymentsSummaryValue"/>

    </VBox>


    <VBox class="paymentsSummaryCard paymentsSummaryPending">

        <Text
            text="Pending Approval"
            class="paymentsSummaryLabel"/>

        <Title
            id="summaryPending"
            text="0"
            level="H2"
            class="paymentsSummaryValue paymentsSummaryValuePending"/>

    </VBox>


    <VBox class="paymentsSummaryCard paymentsSummaryApproved">

        <Text
            text="Approved"
            class="paymentsSummaryLabel"/>

        <Title
            id="summaryApproved"
            text="0"
            level="H2"
            class="paymentsSummaryValue paymentsSummaryValueApproved"/>

    </VBox>


    <VBox class="paymentsSummaryCard paymentsSummaryRejected">

        <Text
            text="Rejected"
            class="paymentsSummaryLabel"/>

        <Title
            id="summaryRejected"
            text="0"
            level="H2"
            class="paymentsSummaryValue paymentsSummaryValueRejected"/>

    </VBox>

</HBox>
                <!-- ========================================= -->
                <!-- ACTION BAR -->
                <!-- ========================================= -->

                <Toolbar
                    class="paymentsActionBar">

                    <SearchField
                        id="paymentSearch"
                        width="100%"
                        placeholder="Search payments..."
                        liveChange=".onSearch"
                        class="paymentSearch"/>

                    <ToolbarSpacer/>

                    <Button
                        text="Copy Payment"
                        icon="sap-icon://copy"
                        type="Transparent"
                        press=".onCopyPayment"
                        class="copyPaymentButton"/>

                           

                  <HBox>

    <Button
        text="Bulk Upload"
        icon="sap-icon://upload"
        press=".onBulkUpload"
        class="sapUiTinyMarginEnd"/>

    <Button
        text="Create Payment"
        type="Emphasized"
        icon="sap-icon://add"
        press=".onCreatePayment"/>

         <Button
        text="Export"
        icon="sap-icon://download"
        type="Transparent"
        press=".onExportPayments"/>

</HBox>

                </Toolbar>


                <!-- ========================================= -->
                <!-- PAYMENT TABLE CARD -->
                <!-- ========================================= -->

                <VBox
                    class="paymentsTableCard">

                    <Table
                        id="paymentsTable"
                        items="{payments>/payments}"
                        growing="true"
                        growingThreshold="20"
                        growingScrollToLoad="true"
                        mode="None"
                        class="paymentsTable">

                        <!-- ================================ -->
                        <!-- COLUMNS -->
                        <!-- ================================ -->

                        <columns>

                            <Column
                                width="16rem">

                                <Text
                                    text="Payment Reference"
                                    class="tableHeaderText"/>

                            </Column>


                            <Column
                                width="10rem">

                                <Text
                                    text="Company Code"
                                    class="tableHeaderText"/>

                            </Column>


                            <Column
                                hAlign="End"
                                width="10rem">

                                <Text
                                    text="Amount"
                                    class="tableHeaderText"/>

                            </Column>


                            <Column
                                width="8rem">

                                <Text
                                    text="Currency"
                                    class="tableHeaderText"/>

                            </Column>


                            <Column
                                width="11rem">

                                <Text
                                    text="Payment Date"
                                    class="tableHeaderText"/>

                            </Column>


                            <Column
                                width="13rem">

                                <Text
                                    text="Status"
                                    class="tableHeaderText"/>

                            </Column>

                        </columns>


                        <!-- ================================ -->
                        <!-- ROWS -->
                        <!-- ================================ -->

                        <items>

                            <ColumnListItem
                                type="Active"
                                press=".onPaymentPress"
                                class="paymentRow">

                                <cells>

                                    <Text
                                        text="{payments>paymentReference}"
                                        class="paymentReference"/>


                                    <Text
                                        text="{payments>companyCode}"/>


                                    <ObjectNumber
                                        number="{payments>amount}"
                                        unit="{payments>currency}"
                                        emphasized="true"/>


                                    <Text
                                        text="{payments>currency}"/>


                                    <Text
                                        text="{payments>paymentDate}"/>


    <Text
    text="{
        path: 'payments>status',
        formatter: '.formatStatusLabel'
    }"
    class="{
        path: 'payments>status',
        formatter: '.formatStatusPillClass'
    }"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>


                <!-- ========================================= -->
                <!-- FOOTER INFORMATION -->
                <!-- ========================================= -->

                <HBox
                    justifyContent="End"
                    class="paymentsFooter">

                    <Text
                        text="Payment Operations"
                        class="paymentsFooterText"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>