<mvc:View
    controllerName="paymentsapp.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        showHeader="true"
        class="dashboardPage">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <customHeader>

            <Toolbar class="dashboardHeader">

                <HBox
                    alignItems="Center"
                    class="dashboardBrand">

                    <core:Icon
                        src="sap-icon://money-bills"
                        size="1.35rem"
                        class="dashboardBrandIcon"/>

                    <Title
                        text="Payment Operations"
                        level="H2"
                        class="dashboardHeaderTitle"/>

                </HBox>

                <ToolbarSpacer/>

                <HBox
                    alignItems="Center"
                    class="dashboardUser">

                    <core:Icon
                        src="sap-icon://person-placeholder"
                        size="1rem"
                        class="dashboardUserIcon"/>

                    <Text
                        text="Administrator"
                        class="dashboardUserText"/>

                    <Button
                        text="Logout"
                        icon="sap-icon://log"
                        type="Transparent"
                        press=".onLogout"
                        class="dashboardLogout"/>

                </HBox>

            </Toolbar>

        </customHeader>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <content>

            <VBox
                class="dashboardContent"
                width="100%">


                <!-- ================================================= -->
                <!-- INTRODUCTION -->
                <!-- ================================================= -->

                <VBox
                    class="dashboardIntro">

                    <Title
                        text="Welcome, Administrator"
                        level="H1"
                        class="dashboardWelcome"/>

                    <Text
                        text="SAP Banking Payment Operations"
                        class="dashboardSubtitle"/>

                </VBox>


                <!-- ================================================= -->
                <!-- KPI CARDS -->
                <!-- ================================================= -->

                <HBox
                    class="kpiContainer"
                    justifyContent="SpaceBetween"
                    width="100%">


                    <!-- ============================================= -->
                    <!-- TOTAL PAYMENTS -->
                    <!-- ============================================= -->

                    <GenericTile
                        class="kpiTile kpiTotal"
                        header="Total Payments"
                        subheader="All Payments"
                        press=".onTotalPayments">

                        <TileContent>

                            <NumericContent
                                value="{dashboard>/total}"
                                icon="sap-icon://money-bills"
                                valueColor="Neutral"/>

                        </TileContent>

                    </GenericTile>


                    <!-- ============================================= -->
                    <!-- PENDING APPROVAL -->
                    <!-- ============================================= -->

                    <GenericTile
                        class="kpiTile kpiPending"
                        header="Pending Approval"
                        subheader="Awaiting Action"
                        press=".onPendingPayments">

                        <TileContent>

                            <NumericContent
                                value="{dashboard>/pending}"
                                icon="sap-icon://pending"
                                valueColor="Critical"/>

                        </TileContent>

                    </GenericTile>


                    <!-- ============================================= -->
                    <!-- APPROVED -->
                    <!-- ============================================= -->

                    <GenericTile
                        class="kpiTile kpiApproved"
                        header="Approved"
                        subheader="Approved Payments"
                        press=".onApprovedPayments">

                        <TileContent>

                            <NumericContent
                                value="{dashboard>/approved}"
                                icon="sap-icon://accept"
                                valueColor="Good"/>

                        </TileContent>

                    </GenericTile>


                    <!-- ============================================= -->
                    <!-- REJECTED -->
                    <!-- ============================================= -->

                    <GenericTile
                        class="kpiTile kpiRejected"
                        header="Rejected"
                        subheader="Rejected Payments"
                        press=".onRejectedPayments">

                        <TileContent>

                            <NumericContent
                                value="{dashboard>/rejected}"
                                icon="sap-icon://decline"
                                valueColor="Error"/>

                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- ================================================= -->
                <!-- QUICK ACTIONS -->
                <!-- ================================================= -->

                <VBox
                    class="dashboardSection">

                    <VBox
                        class="sectionHeader">

                        <Title
                            text="Quick Actions"
                            level="H2"
                            class="sectionTitle"/>

                        <Text
                            text="Frequently used payment operations"
                            class="sectionSubtitle"/>

                    </VBox>


                    <HBox
                        class="quickActions"
                        alignItems="Center">


                        <!-- VIEW PAYMENTS -->

                        <Button
                            text="View Payments"
                            icon="sap-icon://list"
                            type="Emphasized"
                            press=".onViewPayments"
                            class="quickActionPrimary"/>


                        <!-- APPROVAL INBOX -->

                        <Button
                            text="Approval Inbox"
                            icon="sap-icon://task"
                            type="Transparent"
                            press=".onApprovalInbox"
                            class="quickActionButton"/>


                        <!-- USER MANAGEMENT -->

                        <Button
                            text="User Management"
                            icon="sap-icon://group"
                            type="Transparent"
                            press=".onUserManagement"
                            class="quickActionButton"/>

                    </HBox>

                </VBox>


                <!-- ================================================= -->
                <!-- RECENT PAYMENTS -->
                <!-- ================================================= -->

                <VBox
                    class="recentPaymentsCard">


                    <!-- ============================================= -->
                    <!-- RECENT PAYMENTS HEADER -->
                    <!-- ============================================= -->

                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="recentPaymentsHeader">

                        <VBox>

                            <Title
                                text="Recent Payments"
                                level="H2"
                                class="sectionTitle"/>

                            <Text
                                text="Latest payment transactions"
                                class="sectionSubtitle"/>

                        </VBox>


                        <Button
                            text="View All"
                            icon="sap-icon://navigation-right-arrow"
                            iconFirst="false"
                            type="Transparent"
                            press=".onViewPayments"/>

                    </HBox>


                    <!-- ============================================= -->
                    <!-- RECENT PAYMENTS TABLE -->
                    <!-- ============================================= -->

                    <Table
                        id="recentPaymentsTable"
                        items="{dashboard>/recentPayments}"
                        growing="false"
                        class="recentPaymentsTable">


                        <!-- ========================================= -->
                        <!-- COLUMNS -->
                        <!-- ========================================= -->

                        <columns>

                            <!-- REFERENCE -->

                            <Column
                                width="25%">

                                <Text
                                    text="Reference"
                                    class="tableHeader"/>

                            </Column>


                            <!-- COMPANY -->

                            <Column
                                width="15%">

                                <Text
                                    text="Company"
                                    class="tableHeader"/>

                            </Column>


                            <!-- AMOUNT -->

                            <Column
                                width="18%"
                                hAlign="End">

                                <Text
                                    text="Amount"
                                    class="tableHeader"/>

                            </Column>


                            <!-- CURRENCY -->

                            <Column
                                width="15%">

                                <Text
                                    text="Currency"
                                    class="tableHeader"/>

                            </Column>


                            <!-- STATUS -->

                            <Column
                                width="27%">

                                <Text
                                    text="Status"
                                    class="tableHeader"/>

                            </Column>

                        </columns>


                        <!-- ========================================= -->
                        <!-- ROWS -->
                        <!-- ========================================= -->

                        <items>

                            <ColumnListItem>

                                <cells>


                                    <!-- PAYMENT REFERENCE -->

                                    <Text
                                        text="{dashboard>paymentReference}"
                                        class="recentReference"/>


                                    <!-- COMPANY CODE -->

                                    <Text
                                        text="{dashboard>companyCode}"/>


                                    <!-- AMOUNT -->

                                    <ObjectNumber
                                        number="{dashboard>amount}"
                                        emphasized="true"/>


                                    <!-- CURRENCY -->

                                    <Text
                                        text="{dashboard>currency}"/>


                                    <!-- STATUS -->

                                    <ObjectStatus
                                        text="{dashboard>status}"
                                        state="{
                                            path: 'dashboard>status',
                                            formatter: '.formatPaymentStatusState'
                                        }"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <HBox
                    justifyContent="End"
                    class="dashboardFooter">

                    <Text
                        text="Payment Operations"
                        class="dashboardFooterText"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>